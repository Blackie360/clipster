[Unit]
Description=clipster clipboard capture daemon
Documentation=https://github.com/Blackie360/clipster
# Capture needs a display server; without one the daemon exits immediately.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/clipsterd
# The PRD asks for auto-restart on crash. RestartSec keeps a persistently
# failing daemon (no DISPLAY, for instance) from spinning in a tight loop.
Restart=always
RestartSec=2s

# The daemon touches exactly three places: its data dir, its runtime dir, and
# the display socket. Everything else is off the table.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/clipster
ProtectKernelTunables=true
# ProtectKernelModules= is deliberately absent. It implies
# CapabilityBoundingSet=~CAP_SYS_MODULE, and an unprivileged user manager has
# no CAP_SETPCAP to drop bounding-set capabilities with, so the unit dies at
# step CAPABILITIES (status 218) before clipsterd ever runs. v0.1.0 shipped it
# and the daemon never started for anyone. PrivateDevices=, ProtectClock= and
# ProtectKernelLogs= are out for the same reason; a process that never had
# CAP_SYS_MODULE cannot load a module regardless.
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=graphical-session.target
